# AEROVATA by TASPORA — Environment Variables Configuration
# Copy this file to .env.local for local overrides

# Application Branding
VITE_APP_TITLE=AEROVATA by TASPORA — Autonomous Drone Delivery Command Center

# Geospatial Tile Settings (Optional overrides; defaults to public Esri World Imagery & CARTO)
VITE_MAP_TILE_PROVIDER=esri

# Future Hardware / MAVLink Backend Gateway (Leave blank for autonomous client-side simulation)
VITE_TELEMETRY_API_URL=
VITE_TELEMETRY_WS_URL=

# DGCA Airspace Integration Settings
# Primary Statutory Baseline: Built-in DGCA Drone Rules 2021 statutory metro registry (Coimbatore, Chennai, Bengaluru, Delhi NCR, Mumbai MMR)
# Optional Live Mappls (MapmyIndia) Airspace Integration (https://developer.mappls.com/mapping/air-space/)
VITE_MAPPLS_API_KEY=
VITE_MAPPLS_ACCESS_TOKEN=
VITE_AIRSPACE_PROVIDER=HYBRID
